---
import '../styles/global.css';

import Terminal from '../components/Terminal.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Scott Roberts — Cyber Security Professional" />
    <title>Scott Roberts</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFA] text-[#1A1A2E] font-sans antialiased">
    <slot />
  <Terminal />
    <script>
      console.log("%cIf you're reading this, you're my kind of visitor ;P", "font-size: 16px; color: #F97316;");
    </script>

    <script>
      const originalTitle = document.title;
      document.addEventListener('visibilitychange', () => {
        document.title = document.hidden ? 'Come back! 👋' : originalTitle;
      });
    </script>

  </body>
</html>