---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="min-h-screen bg-[#FAFAFA] flex flex-col">

    <!-- Navigation -->
    <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-[#FAFAFA] px-8 py-6 flex justify-between items-center transition-shadow duration-300">
      <div class="max-w-6xl mx-auto w-full flex justify-between items-center">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 bg-[#2563EB] rounded-lg flex items-center justify-center group-hover:bg-[#F97316] transition-colors duration-300">
            <span class="font-mono text-white text-sm font-bold">SR</span>
          </div>
          <span class="font-mono text-[#1A1A2E] text-sm font-medium hidden md:block">sroberts.dev</span>
        </a>
        <div class="flex gap-8 text-sm font-medium text-[#6B7280]">
          <a href="/about" class="hover:text-[#1A1A2E] transition-colors">About</a>
          <a href="/projects" class="hover:text-[#1A1A2E] transition-colors">Projects</a>
          <a href="/blog" class="text-[#1A1A2E]">Blog</a>
          <a href="/#contact" class="hover:text-[#1A1A2E] transition-colors">Contact</a>
        </div>
      </div>
    </nav>
  <div class="flex-grow">

    <!-- Header -->
    <section class="max-w-6xl mx-auto px-8 pt-40 pb-16">
      <p class="font-mono text-[#F97316] text-sm mb-4 tracking-wider">Blog</p>
      <h1 class="text-5xl font-extrabold text-[#1A1A2E] mb-6 leading-tight">
        Thoughts &amp; writeups
      </h1>
      <p class="text-lg text-[#6B7280] max-w-2xl leading-relaxed">
        Security concepts, CTF writeups, learning notes and industry thoughts.
        Written for people who are curious about cyber security — not just those already in it.
      </p>
    </section>

    <!-- Post grid -->
    <section class="max-w-6xl mx-auto px-8 pb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <div class="border border-[#E5E7EB] rounded-xl p-6 hover:border-[#2563EB] transition-colors">
          <span class="bg-[#EFF6FF] text-[#2563EB] text-xs font-mono px-2 py-1 rounded">Coming Soon</span>
          <h3 class="font-bold text-[#1A1A2E] mt-4 mb-2">What is a CTF and why should you care?</h3>
          <p class="text-sm text-[#6B7280]">An introduction to Capture The Flag competitions and how they translate to real world security skills.</p>
        </div>

        <div class="border border-[#E5E7EB] rounded-xl p-6 hover:border-[#2563EB] transition-colors">
          <span class="bg-[#EFF6FF] text-[#2563EB] text-xs font-mono px-2 py-1 rounded">Coming Soon</span>
          <h3 class="font-bold text-[#1A1A2E] mt-4 mb-2">Why small businesses are the biggest cyber security target</h3>
          <p class="text-sm text-[#6B7280]">Most attacks don't target large corporations — here's why your local solicitor is more at risk than you think.</p>
        </div>

        <div class="border border-[#E5E7EB] rounded-xl p-6 hover:border-[#2563EB] transition-colors">
          <span class="bg-[#EFF6FF] text-[#2563EB] text-xs font-mono px-2 py-1 rounded">Coming Soon</span>
          <h3 class="font-bold text-[#1A1A2E] mt-4 mb-2">Getting started with Hack The Box as a complete beginner</h3>
          <p class="text-sm text-[#6B7280]">A honest guide to starting HTB when you feel like you don't know enough — because nobody ever does.</p>
        </div>

      </div>
    </section>
  </div>
    <!-- Footer -->
    <footer class="bg-[#1A1A2E] border-t border-white/10 py-6">
      <div class="max-w-6xl mx-auto px-8 flex justify-between items-center">
        <span class="font-mono text-[#6B7280] text-sm">© 2026 Scott Roberts</span>
        <span class="font-mono text-[#6B7280] text-sm">sroberts.dev</span>
      </div>
    </footer>
  </main>

  <script>
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        navbar?.classList.add('shadow-md');
      } else {
        navbar?.classList.remove('shadow-md');
      }
    });
  </script>
</Layout>
