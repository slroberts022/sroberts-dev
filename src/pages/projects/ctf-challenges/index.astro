---
import Layout from '../../../layouts/Layout.astro';
---
<Layout>
  <main class="min-h-screen bg-[#FAFAFA] flex flex-col">

    <!-- Navigation -->
    <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-[#FAFAFA] px-8 py-6 flex justify-between items-center transition-shadow duration-300">
      <div class="max-w-6xl mx-auto w-full flex justify-between items-center">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 bg-[#2563EB] rounded-lg flex items-center justify-center group-hover:bg-[#F97316] transition-colors duration-300">
            <span class="font-mono text-white text-sm font-bold">SR</span>
          </div>
          <span class="font-mono text-[#1A1A2E] text-sm font-medium hidden md:block">sroberts.dev</span>
        </a>
        <div class="flex gap-8 text-sm font-medium text-[#6B7280]">
          <a href="/about" class="hover:text-[#1A1A2E] transition-colors">About</a>
          <a href="/projects" class="text-[#1A1A2E]">Projects</a>
          <a href="/blog" class="hover:text-[#1A1A2E] transition-colors">Blog</a>
          <a href="/#contact" class="hover:text-[#1A1A2E] transition-colors">Contact</a>
        </div>
      </div>
    </nav>

    <div class="flex-grow">

      <!-- Back link + header -->
      <section class="max-w-3xl mx-auto px-8 pt-40 pb-12">
        <a href="/projects" class="font-mono text-[#F97316] text-sm tracking-wider hover:underline">← Back to projects</a>
        <p class="font-mono text-[#F97316] text-sm mt-6 mb-2 tracking-wider">CTF</p>
        <h1 class="text-4xl md:text-5xl font-extrabold text-[#1A1A2E] mb-6 leading-tight">
          CTF Challenges
        </h1>
        <p class="text-lg text-[#6B7280] leading-relaxed">
          Real capture-the-flag scenarios, hidden inside the terminal in the
          corner of this site. Open it and type <code class="bg-[#F3F4F6] px-1.5 py-0.5 rounded text-sm">ctf</code> to begin.
        </p>
      </section>

      <!-- Intro -->
      <section class="max-w-3xl mx-auto px-8 pb-16 space-y-6 text-[#6B7280] leading-relaxed">
        <p>
          This isn't a writeup about a CTF I did elsewhere - it's one I
          built, entirely from scratch, into the terminal widget on this
          site.
        </p>

        <h2 class="text-2xl font-bold text-[#1A1A2E] pt-6">How to start</h2>
        <p>
          Open the terminal (bottom-right corner of any page), and type:
        </p>
        <p class="font-mono bg-[#1A1A2E] text-white px-4 py-3 rounded-lg text-sm">
          ctf
        </p>
        <p>
          You'll get a menu of available challenges. Every tool referenced
          throughout - behaving the way the real thing would and gated
          realistically rather than just accepting any input in any order.
        </p>
        <p>
          A "brief" panel tracks your case notes as you go, so you're never
          stuck re-reading terminal scrollback to remember what you're
          trying to do. Type <code class="bg-[#F3F4F6] px-1.5 py-0.5 rounded text-sm">brief</code> any
          time to reopen it.
        </p>


        <div class="bg-white border border-[#E5E7EB] rounded-xl p-6 mt-8">
          <p class="text-sm text-[#6B7280]">
            Curious how this was actually built? the state machine, the login prompt, the brief panel? Read the technical writeup on 
            <a href="/projects/this-website/building-the-ctf" class="text-[#2563EB] hover:text-blue-700 font-medium"> This Website →</a>
          </p>
        </div>

      </section>

      <!-- Challenge list -->
      <section class="max-w-3xl mx-auto px-8 pb-24 space-y-4">
        <p class="font-mono text-[#F97316] text-sm tracking-wider mb-2">Available Challenges</p>
        <a href="/projects/ctf-challenges/the-vault" class="block bg-white border border-[#E5E7EB] rounded-xl p-6 hover:border-[#2563EB] transition-colors">
          <span class="bg-[#EFF6FF] text-[#2563EB] text-xs font-mono px-2 py-1 rounded">Beginner</span>
          <h2 class="font-bold text-[#1A1A2E] text-xl mt-3 mb-2">The Vault</h2>
          <p class="text-sm text-[#6B7280]">Recon to root. Scanning, service enumeration, credential recovery, and a foothold - no spoilers, just the tools involved.</p>
        </a>

        <div class="bg-white border border-dashed border-[#E5E7EB] rounded-xl p-6">
          <span class="bg-[#F3F4F6] text-[#6B7280] text-xs font-mono px-2 py-1 rounded">Coming soon</span>
          <h2 class="font-bold text-[#6B7280] text-xl mt-3 mb-2">More challenges</h2>
          <p class="text-sm text-[#9CA3AF]">Different techniques, different difficulty. Watch this space.</p>
        </div>
      </section>

    </div>

    <!-- Footer -->
    <footer class="bg-[#1A1A2E] border-t border-white/10 py-6">
      <div class="max-w-6xl mx-auto px-8 flex justify-between items-center">
        <span class="font-mono text-[#6B7280] text-sm">© 2026 Scott Roberts</span>
        <span class="font-mono text-[#6B7280] text-sm">sroberts.dev</span>
      </div>
    </footer>
  </main>

  <script>
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        navbar?.classList.add('shadow-md');
      } else {
        navbar?.classList.remove('shadow-md');
      }
    });
  </script>
</Layout>