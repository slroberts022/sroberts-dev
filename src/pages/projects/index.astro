---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="min-h-screen bg-[#FAFAFA]">

    <!-- Navigation -->
    <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-[#FAFAFA] px-8 py-6 flex justify-between items-center transition-shadow duration-300">
      <div class="max-w-6xl mx-auto w-full flex justify-between items-center">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 bg-[#2563EB] rounded-lg flex items-center justify-center group-hover:bg-[#F97316] transition-colors duration-300">
            <span class="font-mono text-white text-sm font-bold">SR</span>
          </div>
          <span class="font-mono text-[#1A1A2E] text-sm font-medium hidden md:block">sroberts.dev</span>
        </a>
        <div class="flex gap-8 text-sm font-medium text-[#6B7280]">
          <a href="/about" class="hover:text-[#1A1A2E] transition-colors">About</a>
          <a href="/projects" class="text-[#1A1A2E]">Projects</a>
          <a href="/blog" class="hover:text-[#1A1A2E] transition-colors">Blog</a>
          <a href="/#contact" class="hover:text-[#1A1A2E] transition-colors">Contact</a>
        </div>
      </div>
    </nav>

    <!-- Header -->
    <section class="max-w-6xl mx-auto px-8 pt-40 pb-16">
      <p class="font-mono text-[#F97316] text-sm mb-4 tracking-wider">Projects</p>
      <h1 class="text-5xl font-extrabold text-[#1A1A2E] mb-6 leading-tight">
        What I've built &amp; solved
      </h1>
      <p class="text-lg text-[#6B7280] max-w-2xl leading-relaxed">
        Competitions, research, development and ongoing security practice —
        this grows as I complete more.
      </p>
    </section>
<!-- Bento grid -->
    <section class="max-w-6xl mx-auto px-4 md:px-8 pb-24">
      <div class="grid grid-cols-2 md:grid-cols-4 auto-rows-auto md:auto-rows-[170px] gap-4 md:gap-6 grid-flow-dense">

        <!-- Skills Wales — flagship, large -->
        <a id="skills-wales" href="/projects/skills-wales" class="col-span-2 row-span-1 md:row-span-2 bg-white rounded-xl p-6 md:p-8 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group scroll-mt-24 target:ring-2 target:ring-[#2563EB] target:ring-offset-4 target:shadow-lg transition-shadow duration-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F97316] focus-visible:ring-offset-2">
          <div>
            <span class="bg-[#EFF6FF] text-[#2563EB] text-xs font-mono px-2 py-1 rounded">CTF</span>
            <h3 class="font-bold text-[#1A1A2E] text-xl md:text-2xl mt-4 mb-2">Skills Wales Competition</h3>
            <p class="text-sm text-[#6B7280] leading-relaxed">Placed 2nd in the national Skills Wales cyber security competition, competing against industry apprentices actively working in the sector.</p>
          </div>
          <p class="text-xs font-mono text-[#F97316] group-hover:underline mt-4">2nd Place — National Level →</p>
        </a>

        <!-- VR Game — wide -->
        <a id="vr-game" href="/projects/vr-game" class="col-span-2 row-span-1 bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group scroll-mt-24 target:ring-2 target:ring-[#2563EB] target:ring-offset-4 target:shadow-lg transition-shadow duration-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F97316] focus-visible:ring-offset-2">
          <div>
            <span class="bg-[#EFF6FF] text-[#2563EB] text-xs font-mono px-2 py-1 rounded">Dev</span>
            <h3 class="font-bold text-[#1A1A2E] mt-3 mb-1">VR Game — Unity &amp; Blender</h3>
            <p class="text-sm text-[#6B7280] leading-relaxed">C#, Unity and Blender, built as part of my foundation degree.</p>
          </div>
          <p class="text-xs font-mono text-[#F97316] group-hover:underline mt-2">See the build →</p>
        </a>

        <!-- HTB Writeups — tall on desktop, normal on mobile -->
        <a id="htb-writeups" href="/projects/htb-writeups" class="col-span-1 row-span-1 md:row-span-2 bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow border-2 border-dashed border-[#E5E7EB] flex flex-col justify-between group scroll-mt-24 target:ring-2 target:ring-[#2563EB] target:ring-offset-4 target:shadow-lg transition-shadow duration-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F97316] focus-visible:ring-offset-2">
          <div>
            <span class="bg-[#F3F4F6] text-[#6B7280] text-xs font-mono px-2 py-1 rounded">HTB</span>
            <h3 class="font-bold text-[#6B7280] mt-3 mb-1">Hack The Box Writeups</h3>
            <p class="text-sm text-[#9CA3AF] leading-relaxed">CTF writeups and machine solutions as I work through Hack The Box.</p>
          </div>
          <p class="text-xs font-mono text-[#9CA3AF] mt-2">Coming soon</p>
        </a>

        <!-- Social Media Research — normal -->
        <a id="social-media-study" href="/projects/social-media-study" class="col-span-1 row-span-1 bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow scroll-mt-24 target:ring-2 target:ring-[#2563EB] target:ring-offset-4 target:shadow-lg duration-700">
          <span class="bg-[#EFF6FF] text-[#2563EB] text-xs font-mono px-2 py-1 rounded">Research</span>
          <h3 class="font-bold text-[#1A1A2E] mt-3 mb-1">Social Media &amp; Productivity Study</h3>
          <p class="text-xs font-mono text-[#F97316] mt-2">380 Respondents</p>
        </a>

        <!-- CTF Challenges — normal, placeholder -->
        <div id="ctf-challenges" class="col-span-1 row-span-1 bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow border-2 border-dashed border-[#E5E7EB] scroll-mt-24 target:ring-2 target:ring-[#2563EB] target:ring-offset-4 target:shadow-lg duration-700">
          <span class="bg-[#F3F4F6] text-[#6B7280] text-xs font-mono px-2 py-1 rounded">CTF</span>
          <h3 class="font-bold text-[#6B7280] mt-3 mb-1">CTF Challenges</h3>
          <p class="text-xs font-mono text-[#9CA3AF] mt-2">Coming soon</p>
        </div>

        <!-- Home Lab — normal, placeholder -->
        <div id="home-lab" class="col-span-1 row-span-1 bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow border-2 border-dashed border-[#E5E7EB] scroll-mt-24 target:ring-2 target:ring-[#2563EB] target:ring-offset-4 target:shadow-lg duration-700">
          <span class="bg-[#F3F4F6] text-[#6B7280] text-xs font-mono px-2 py-1 rounded">Lab</span>
          <h3 class="font-bold text-[#6B7280] mt-3 mb-1">Home Lab</h3>
          <p class="text-xs font-mono text-[#9CA3AF] mt-2">Coming soon</p>
        </div>

      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#1A1A2E] border-t border-white/10 py-6">
      <div class="max-w-6xl mx-auto px-8 flex justify-between items-center">
        <span class="font-mono text-[#6B7280] text-sm">© 2026 Scott Roberts</span>
        <span class="font-mono text-[#6B7280] text-sm">sroberts.dev</span>
      </div>
    </footer>
  </main>

  <script>
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        navbar?.classList.add('shadow-md');
      } else {
        navbar?.classList.remove('shadow-md');
      }
    });
  </script>

  <script>
    const hash = window.location.hash.slice(1);
    if (hash) {
      const target = document.getElementById(hash);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  </script>
</Layout>
